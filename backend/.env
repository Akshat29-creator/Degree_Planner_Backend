# Database - PostgreSQL via Docker (run: docker compose up db redis -d)
DATABASE_URL=postgresql://planner:plannerdev@localhost:5432/degree_planner

# Ollama - Local AI (No cloud, no API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_FAST_MODEL=qwen3:8b-q4_K_M
OLLAMA_REASONING_MODEL=qwen3:8b-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# Speed & Performance Optimization (Thinking OFF, 100% GPU VRAM, High Output Tokens)
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_GPU=99
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_BATCH=512
OLLAMA_KEEP_ALIVE=60m

# CORS - Allow frontend
CORS_ORIGINS=["http://localhost:3000"]

# App
DEBUG=true
